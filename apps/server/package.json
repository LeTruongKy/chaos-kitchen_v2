    "@kitchen/core": "workspace:*",
    "express": "4.21.0"
  },
  "devDependencies": {
    "@colyseus/testing": "0.16.0",
    "@colyseus/tools": "0.16.0",
    "@types/express": "4.17.21",
    "colyseus.js": "0.16.22",
    "tsup": "8.3.0",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vitest": "2.1.2"
  }
